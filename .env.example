# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Which provider the workflow calls.
#   mock      (default) — no network, no cost. Safe for tests and local UI work.
#   anthropic           — real API calls. Costs money per call.
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=anthropic.
# Create at https://console.anthropic.com — set a monthly spend limit on the key.
# Note: a Claude Pro/Max subscription does NOT include API access; API billing is separate.
ANTHROPIC_API_KEY=

# Model override. Defaults to claude-haiku-4-5 (cheap, for iteration).
# Use claude-opus-5 for recorded runs whose numbers are published.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Live-run guardrails (only apply when LLM_PROVIDER=anthropic) ---

# Daily ceiling on live model spend. Reserved before each call and reconciled
# after, so the request that would break the budget never happens.
LIVE_DAILY_BUDGET_USD=2

# Live runs one caller may make per hour. Identified by x-forwarded-for, which
# is only trustworthy behind a proxy that sets it.
LIVE_RUNS_PER_HOUR=5

# Most a single live run may be estimated to cost. The default admits
# Haiku 4.5 and excludes Sonnet and Opus. Raise it locally to demo Opus.
LIVE_MAX_RUN_COST_USD=0.05
